# =============================================================================
# IBM Cloud Lite & IBM Granite Configuration
# Tele-Law Access Equity Analysis
# =============================================================================

# ── IBM Cloud Credentials ────────────────────────────────────────────────────
IBM_CLOUD_API_KEY=your_ibm_cloud_api_key_here
IBM_CLOUD_URL=https://us-south.ml.cloud.ibm.com

# ── IBM watsonx.ai (Granite) ─────────────────────────────────────────────────
WATSONX_PROJECT_ID=your_watsonx_project_id_here
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# IBM Granite Model ID (Lite tier supported models)
GRANITE_MODEL_ID=ibm/granite-13b-instruct-v2
# Alternative smaller model for Lite quota: ibm/granite-3-8b-instruct

# ── IBM Watson Studio (optional – for notebook execution) ────────────────────
WATSON_STUDIO_URL=https://us-south.ml.cloud.ibm.com
WATSON_STUDIO_PROJECT_ID=your_watson_studio_project_id_here

# ── Data Source ──────────────────────────────────────────────────────────────
# data.gov.in API for Tele-Law dataset (FY 2021-22 to 2024-25)
DATAGOV_RESOURCE_ID=your_datagov_resource_id_here
DATAGOV_API_BASE_URL=https://api.data.gov.in/resource
DATAGOV_API_KEY=your_datagov_api_key_here
# Dataset URL: https://www.data.gov.in/resource/district-wise-tele-law-case-registration-and-advice-enabled-data-fy-2021-22-2024-25

# ── Application Settings ─────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
REPORT_OUTPUT_DIR=reports
PROCESSED_DATA_DIR=data/processed
RAW_DATA_DIR=data/raw

# ── Analysis Parameters ──────────────────────────────────────────────────────
# Equity threshold: minimum % share for marginalized groups (SC+ST+OBC)
EQUITY_THRESHOLD_PCT=70
# Minimum CSC count to include a district in regional comparison
MIN_CSC_COUNT=1
